{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "休息提醒助手",
  "version": "0.1.0",
  "identifier": "com.restreminder.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "休息提醒助手",
        "width": 440,
        "height": 700,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "minimizable": true,
        "closable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
